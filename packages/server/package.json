{
  "name": "@memstack/server",
  "version": "0.7.1",
  "description": "REST API server for MemStack — self-hostable agent memory",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "memstack-server": "dist/serve.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isiomaC/memstack.git"
  },
  "bugs": {
    "url": "https://github.com/isiomaC/memstack/issues"
  },
  "homepage": "https://github.com/isiomaC/memstack",
  "scripts": {
    "build": "tsup src/index.ts src/serve.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/serve.ts --format esm --dts --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm exec tsc --noEmit && pnpm exec vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@memstack/core": "workspace:*",
    "hono": "^4.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@memstack/config-env": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "api",
    "memory",
    "ai",
    "agent",
    "rest"
  ],
  "license": "MIT"
}
